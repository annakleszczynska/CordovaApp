{
  "app": {
    "base_language": "en",
    "push": {
      "source": [
        {
          "path": "./www/_BASE.xliff",
          "file_format": "xliff",
          "tag": "app:Localizable.xliff",
          "onlyAsDraft": true,
          "importIntoGroup": true,
          "importStatus": true,
          "createUnknownCustomStates": true,
          "skipLockedTranslations": true,
          "importSourceLanguage": false,
          "onlyIfTextEmpty": true,
          "keepTagIds": false,
          "skipEmptyTranslations": false,
          "language": "en",
          "key_prefix": "xlf_"
        },
        {
          "path": "./www/android_xml.xml",
          "file_format": "android_xml",
          "tag": "app:strings.xml",
          "language": "en",
          "key_prefix": "axml_"
        },
        {
          "path": "./www/csv.csv",
          "file_format": "csv",
          "tag": "app:language:5622.csv",
          "columnDescription": {
            "KEY": 0,
            "en": 1
          },
          "excludeHeaderRow": true,
          "language": "en",
          "key_prefix": "csv_"
        },
        {
          "path": "./www/ember_i18n_json_module.js",
          "file_format": "ember_i18n_json_module",
          "tag": "app:translations.js",
          "language": "en",
          "key_prefix": "ember_"
        },
        {
          "path": "./www/i18n/en.csv",
          "file_format": "csv",
          "tag": "app:language.csv",
          "columnDescription": {
            "KEY": 0,
            "en": 1
          },
          "excludeHeaderRow": true,
          "language": "en",
          "key_prefix": "csv_"
        },
        {
          "remove_cr_char": true,
          "language": "en",
          "file_format": "nested_json",
          "path": "./translations/app/en.json",
          "tag": "app:language.json",
          "tag_category": "Web",
          "key_prefix": "nestedJson_"
        },
        {
          "path": "./www/en.xlsx",
          "file_format": "xls",
          "tag": "app:language.xls",
          "columnDescription": {
            "KEY": 0,
            "en": 1
          },
          "excludeHeaderRow": true,
          "sheetName": "test me",
          "language": "en",
          "key_prefix": "xls_"
        },
        {
          "path": "./www/flutter_arb.arb",
          "file_format": "arb",
          "tag": "app:language.arb",
          "language": "en",
          "key_prefix": "arb_"
        },
        {
          "path": "./www/gettext_po.po",
          "file_format": "gettext_po",
          "tag": "app:language.po",
          "language": "en"
        },
        {
          "path": "./www/gettext_pot.pot",
          "file_format": "gettext_pot",
          "tag": "app:language.po",
          "language": "en"
        },
        {
          "path": "./www/i18next_json.json",
          "file_format": "node_2_json",
          "tag": "app:language:4001.json",
          "language": "en"
        },
        {
          "path": "./www/ini.ini",
          "file_format": "ini",
          "tag": "app:language.ini",
          "language": "en"
        },
        {
          "path": "./www/ios_strings.strings",
          "file_format": "ios_strings",
          "tag": "app:Localizable.strings",
          "language": "en"
        },
        {
          "path": "./www/ios_stringsdict.stringsdict",
          "file_format": "ios_stringsdict",
          "tag": "app:Localizable.strings",
          "language": "en"
        },
        {
          "path": "./www/java_properties.properties",
          "file_format": "java_properties",
          "tag": "app:ApplicationMessages.properties",
          "language": "en"
        },
        {
          "path": "./www/laravel_php.php",
          "file_format": "laravel_php",
          "tag": "app:language.php",
          "language": "en"
        }
      ]
    },
    "pull": {
      "target": [
        {
          "path": "./www/<language>.xliff",
          "file_format": "xliff",
          "tag": "app:Localizable.xliff",
          "export_empty": true,
          "includeStatus": true,
          "includeContextUrl": true,
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "xlf_"
        },
        {
          "path": "./www/<language>.xml",
          "file_format": "android_xml",
          "tag": "app:strings.xml",
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "axml_"
        },
        {
          "path": "./www/<language>.csv",
