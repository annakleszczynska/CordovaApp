            "en"
          ]
        },
        {
          "path": "./www/<language>.po",
          "file_format": "gettext_po",
          "tag": "app:language.po",
          "exclude_languages": [
            "en"
          ]
        },
        {
          "path": "./www/i18next_json _<language>.json",
          "file_format": "node_2_json",
          "tag": "app:language:4001.json",
          "exclude_languages": [
            "en"
          ]
        },
        {
          "path": "./www/<language>.ini",
          "file_format": "ini",
          "tag": "app:language.ini",
          "exclude_languages": [
            "en"
          ]
        },
        {
          "path": "./www/<language>.strings",
          "file_format": "ios_strings",
          "tag": "app:Localizable.strings",
          "exclude_languages": [
            "en"
          ]
        },
        {
          "path": "./www/<language>.strings",
          "file_format": "ios_strings",
          "tag": "app:Localizable.strings",
          "exclude_languages": [
            "en"
          ]
        },
        {
          "path": "./www/java_properties_<language>.properties",
          "file_format": "java_properties",
          "tag": "app:ApplicationMessages.properties",
          "exclude_languages": [
            "en"
          ]
        },
        {
          "path": "./www/<language>.php",
          "file_format": "laravel_php",
