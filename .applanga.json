{
  "app": {
    "base_language": "en",
    "push": {
      "source": [
        {
          "path": "./www/_BASE.xliff",
          "file_format": "xliff",
          "tag": "app:Localizable.xliff",
          "onlyAsDraft": true,
          "importIntoGroup": true,
          "importStatus": true,
          "createUnknownCustomStates": true,
          "skipLockedTranslations": true,
          "importSourceLanguage": false,
          "onlyIfTextEmpty": true,
          "keepTagIds": false,
          "skipEmptyTranslations": false,
          "language": "en",
          "key_prefix": "xlf_"
        },
        {
          "path": "./www/android_xml.xml",
          "file_format": "android_xml",
          "tag": "app:strings.xml",
          "language": "en",
          "key_prefix": "axml_"
        },
        {
          "path": "./www/angular_translate_json.json",
          "file_format": "angular_translate_json",
          "tag": "app:language:3228.json",
          "language": "en",
          "key_prefix": "angularJson_"
        },
        {
          "path": "./www/chrome_i18n_json.json",
          "file_format": "chrome_i18n_json",
          "tag": "app:messages.json",
          "remove_cr_char": true,
          "language": "en",
          "key_prefix": "chrome_"
        },
        {
          "path": "./www/csv.csv",
          "file_format": "csv",
          "tag": "app:language:5622.csv",
          "columnDescription": {
            "KEY": 0,
            "en": 1
          },
          "excludeHeaderRow": true,
          "language": "en",
          "key_prefix": "csv_"
        },
        {
          "path": "./www/ember_i18n_json_module.js",
          "file_format": "ember_i18n_json_module",
          "tag": "app:translations.js",
          "language": "en",
          "key_prefix": "ember_"
        },
        {
          "path": "./www/i18n/en.csv",
          "file_format": "csv",
          "tag": "app:language.csv",
          "columnDescription": {
            "KEY": 0,
            "en": 1
          },
          "excludeHeaderRow": true,
          "language": "en",
          "key_prefix": "csv_"
        },
        {
          "remove_cr_char": true,
          "language": "en",
          "file_format": "nested_json",
          "path": "./translations/app/en.json",
          "tag": "app:language.json",
          "tag_category": "Web",
          "key_prefix": "nestedJson_"
        },
        {
          "path": "./www/en.xlsx",
          "file_format": "xls",
          "tag": "app:language.xls",
          "columnDescription": {
            "KEY": 0,
            "en": 1
          },
          "excludeHeaderRow": true,
          "sheetName": "test me",
          "language": "en",
          "key_prefix": "xls_"
        },
        {
          "path": "./www/flutter_arb.arb",
          "file_format": "arb",
          "tag": "app:language.arb",
          "language": "en",
          "key_prefix": "arb_"
        }
      ]
    },
    "pull": {
      "target": [
        {
          "path": "./www/<language>.xliff",
          "file_format": "xliff",
          "tag": "app:Localizable.xliff",
          "export_empty": true,
          "includeStatus": true,
          "includeContextUrl": true,
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "xlf_"
        },
        {
          "path": "./www/<language>.xml",
          "file_format": "android_xml",
          "tag": "app:strings.xml",
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "axml_"
        },
        {
          "path": "./www/<language>.json",
          "file_format": "angular_translate_json",
          "tag": "app:language:3228.json",
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "angularJson_"
        },
        {
          "path": "./www/<language>.json",
          "file_format": "chrome_i18n_json",
          "tag": "app:messages.json",
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "chrome_"
        },
        {
          "path": "./www/<language>.csv",
          "file_format": "csv",
          "tag": "app:language:5622.csv",
          "excludeHeaderRow": true,
          "excludeBaseLang": true,
          "columnDescription": {
            "KEY": 0,
            "<language>": 1
          },
          "includeStatus": true,
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "csv_"
        },
        {
          "path": "./www/<language>.js",
          "file_format": "ember_i18n_json_module",
          "tag": "app:translations.js",
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "ember_"
        },
        {
          "path": "./www/i18n/<language>.csv",
          "file_format": "csv",
          "tag": "app:language.csv",
          "excludeHeaderRow": true,
          "excludeBaseLang": true,
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "csv_"
        },
        {
          "remove_cr_char": true,
          "exclude_languages": [
            "en"
          ],
          "sort_by_key": true,
          "file_format": "nested_json",
          "path": "./translations/app/<language>.json",
          "tag": "app:language.json",
          "key_prefix": "nestedJson_"
        },
        {
          "path": "./www/<language>.xlsx",
          "file_format": "xls",
          "tag": "app:language.xls",
          "excludeHeaderRow": true,
          "excludeBaseLang": true,
          "columnDescription": {
            "KEY": 0,
            "<language>": 1
          },
          "includeStatus": false,
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "xls_"
        },
        {
          "path": "./www/<language>.arb",
          "file_format": "arb",
          "tag": "app:language.arb",
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "arb_"
        }
      ]
    }
  }
}