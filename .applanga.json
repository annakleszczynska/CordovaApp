          "excludeHeaderRow": true,
          "excludeBaseLang": true,
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "csv_"
        },
        {
          "remove_cr_char": true,
          "exclude_languages": [
            "en"
          ],
          "sort_by_key": true,
          "file_format": "nested_json",
          "path": "./translations/app/<language>.json",
          "tag": "app:language.json",
          "key_prefix": "nestedJson_"
        },
        {
          "path": "./www/<language>.xlsx",
          "file_format": "xls",
          "tag": "app:language.xls",
          "excludeHeaderRow": true,
          "excludeBaseLang": true,
          "columnDescription": {
            "KEY": 0,
            "<language>": 1
          },
          "includeStatus": false,
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "xls_"
        },
        {
          "path": "./www/flutter_arb_<language>.arb",
          "file_format": "arb",
          "tag": "app:language.arb",
          "exclude_languages": [
            "en"
          ],
          "key_prefix": "arb_"
        },
        {
          "path": "./www/<language>.po",
